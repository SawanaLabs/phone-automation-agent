# Shared BigModel secret for backend runtimes. Never ship this in an APK.
BIGMODEL_TOKEN="<your-bigmodel-token>"

# Worker-backed Open-AutoGLM route.
PHONE_AGENT_ENDPOINT="bigmodel"

# Customer Android hosted API route.
CUSTOMER_ANDROID_API_ACCESS_TOKEN="local-alpha-token"
CUSTOMER_ANDROID_MODEL_PROVIDER="openai-compatible"
CUSTOMER_ANDROID_MODEL_ENDPOINT="bigmodel"
CUSTOMER_ANDROID_MODEL_TIMEOUT_SECONDS="120"

# Custom model endpoint route. Leave endpoint keywords unset when using these.
# PHONE_AGENT_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# PHONE_AGENT_MODEL="autoglm-phone"
# PHONE_AGENT_API_KEY="${BIGMODEL_TOKEN}"
# CUSTOMER_ANDROID_MODEL_BASE_URL="https://open.bigmodel.cn/api/paas/v4"
# CUSTOMER_ANDROID_MODEL_NAME="autoglm-phone"
# CUSTOMER_ANDROID_MODEL_API_KEY="${BIGMODEL_TOKEN}"

# Historical ModelScope route:
# MODELSCOPE_TOKEN="<your-modelscope-token>"
# PHONE_AGENT_BASE_URL="https://api-inference.modelscope.cn/v1"
# PHONE_AGENT_MODEL="ZhipuAI/AutoGLM-Phone-9B"
# PHONE_AGENT_API_KEY="${MODELSCOPE_TOKEN}"
# CUSTOMER_ANDROID_MODEL_BASE_URL="https://api-inference.modelscope.cn/v1"
# CUSTOMER_ANDROID_MODEL_NAME="ZhipuAI/AutoGLM-Phone-9B"
# CUSTOMER_ANDROID_MODEL_API_KEY="${MODELSCOPE_TOKEN}"

# Optional runtime overrides:
# OPEN_AUTOGLM_ROOT="/absolute/path/to/Open-AutoGLM"
# PHONE_AGENT_MAX_STEPS="12"
# PHONE_AUTOMATION_WORKER_HOST="127.0.0.1"
# PHONE_AUTOMATION_WORKER_PORT="8765"
