{
  "$schema": "https://turbo.build/schema.json",
  "globalEnv": [
    "CUSTOMER_RUNTIME_HOST",
    "CUSTOMER_RUNTIME_MAX_STEPS",
    "CUSTOMER_RUNTIME_MODEL_TIMEOUT_MS",
    "CUSTOMER_RUNTIME_PORT",
    "CUSTOMER_RUNTIME_SCENARIO",
    "CUSTOMER_ANDROID_API_ACCESS_TOKEN",
    "CUSTOMER_ANDROID_API_HOST",
    "CUSTOMER_ANDROID_API_PORT",
    "CUSTOMER_ANDROID_MODEL_BASE_URL",
    "CUSTOMER_ANDROID_MODEL_API_KEY",
    "CUSTOMER_ANDROID_MODEL_NAME"
  ],
  "ui": "tui",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": ["$TURBO_DEFAULT$", ".env*"],
      "outputs": [".next/**", "!.next/cache/**", "dist/**"]
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "format": {
      "dependsOn": ["^format"]
    },
    "test": {
      "dependsOn": ["^test"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    }
  }
}
